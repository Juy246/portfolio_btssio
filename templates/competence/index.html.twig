{% extends 'base.html.twig' %}

{% block title %}Compétences - Portfolio{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-5 text-center">Mes Compétences</h1>

        {% if grouped_competences is not empty %}
            {% for categorie, competences in grouped_competences %}
                <section class="mb-5">
                    <h2 class="border-bottom pb-2 mb-4">
                        {% if categorie == 'Environnements de développement' %}
                            💻
                        {% elseif categorie == 'Gestion de bases de données et requêtes' %}
                            🗄️
                        {% elseif categorie == 'Développement web' %}
                            🌐
                        {% elseif categorie == 'Développement d''application' %}
                            📱
                        {% elseif categorie == 'Cybersécurité' %}
                            🔒
                        {% elseif categorie == 'Systèmes d''exploitation' %}
                            ⚙️
                        {% elseif categorie == 'Virtualisation' %}
                            🖥️
                        {% elseif categorie == 'Cloud' %}
                            ☁️
                        {% elseif categorie == 'Bureautique' %}
                            📊
                        {% else %}
                            ⚡
                        {% endif %}
                        {{ categorie }}
                    </h2>

                    <div class="row">
                        {% for comp in competences %}
                            <div class="col-md-6 mb-4">
                                {% if comp.getUrl() %}
                                    <a href="{{ comp.getUrl() }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                        <div class="card h-100 shadow-sm border-0 competence-card">
                                            <div class="card-body d-flex align-items-center justify-content-between">
                                                <h5 class="card-title fw-bold mb-0">{{ comp.getNom() }}</h5>
                                                {% if comp.getLogo() %}
                                                    <img src="{{ asset('images/competences/' ~ comp.getLogo()) }}" alt="{{ comp.getNom() }} logo" style="height:32px; width:auto; object-fit:contain;" />
                                                {% else %}
                                                    <span class="badge bg-primary ms-2">{{ _self.getIcon(comp.getNom()) }}</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </a>
                                {% else %}
                                    <div class="card h-100 shadow-sm border-0">
                                        <div class="card-body d-flex align-items-center justify-content-between">
                                            <h5 class="card-title fw-bold mb-0">{{ comp.getNom() }}</h5>
                                            {% if comp.getLogo() %}
                                                <img src="{{ asset('images/competences/' ~ comp.getLogo()) }}" alt="{{ comp.getNom() }} logo" style="height:32px; width:auto; object-fit:contain;" />
                                            {% else %}
                                                <span class="badge bg-secondary ms-2">{{ _self.getIcon(comp.getNom()) }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        {% else %}
            <p class="text-muted text-center">Aucune compétence enregistrée.</p>
        {% endif %}

        <div class="text-center mt-5">
            <a href="{{ path('app_home') }}" class="btn btn-primary">
                ← Retour à l'accueil
            </a>
        </div>
    </div>

    <style>
        .competence-card {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .competence-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1) !important;
        }

        a:has(.competence-card) {
            text-decoration: none;
            color: inherit;
        }

        a:has(.competence-card) .card-title {
            color: inherit;
        }
    </style>
{% endblock %}

