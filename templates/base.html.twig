<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Portfolio - Jingyuan LUO{% endblock %}</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/portfolio.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header>
    <div class="container">
        <div class="header-content">
            <div class="logo">
                <div class="logo-icon">JL</div>
                <span>Portfolio</span>
            </div>
            <nav>
                <a href="{{ path('app_home') }}#about">À propos</a>
                <a href="{{ path('app_home') }}#parcours">Expériences</a>
                <a href="{{ path('app_home') }}#competences">Compétences</a>
                <a href="{{ path('app_home') }}#certifications">Certifications</a>
                <a href="{{ path('app_home') }}#projets">Projets</a>
                <a href="{{ path('app_home') }}#documents">Documents</a>
                <a href="{{ path('app_home') }}#contact">Contact</a>
            </nav>
        </div>
    </div>
</header>

<main>{% block body %}{% endblock %}</main>

<footer>
    <div class="container">
        <div class="footer-content">
            <p class="footer-text">© {{ "now"|date("Y") }} Jingyuan LUO</p>
            <p class="footer-text">
                Développé en Symfony 8 et Bootstrap 5
            </p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
{% endblock %}
</body>
</html>
