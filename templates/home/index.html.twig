{% extends 'base.html.twig' %}

{% block body %}
    <!-- Hero Section -->
    <section class="hero" id="hero">
        <div class="hero-bg">
            <div class="hero-blur-1"></div>
            <div class="hero-blur-2"></div>
        </div>
        <div class="container">
            <div class="hero-content">
                <h1>Jingyuan LUO</h1>
                <p class="subtitle">BTS SIO Spécialité SLAM</p>
                <div class="hero-cta">
                    <a href="#about" class="btn btn-primary"><i class="fas fa-arrow-down btn-icon"></i>Explorer</a>
                </div>
            </div>
        </div>
    </section>

    <!-- À propos Section -->
    <section class="section" id="about">
        <div class="container">
            <div class="section-title">
                <h2>À propos</h2>
            </div>

            <div class="about-grid">
                <div class="fade-in">
                    <h3 style="font-size: 1.3rem; margin-bottom: 1.5rem; color: var(--primary);">Présentation personnelle</h3>
                    <p style="font-size: 1.1rem; margin-bottom: 1.5rem;">
                        Bonjour, je m'appelle Jingyuan LUO, étudiante en formation BTS SIO spécialité SLAM (Solutions Logicielles et Applications Métier).
                    </p>
                    <p style="margin-bottom: 1.5rem;">
                        Passionnée par les nouvelles technologies, l’analyse des besoins et le développement de solutions numériques,
                        je conçois des applications fiables et performantes à l’aide de technologies modernes.
                        Curieuse, rigoureuse et dotée d’une bonne capacité d’adaptation,j’apprécie le travail en équipe ainsi que la résolution
                        de problématiques techniques concrètes.
                    </p>
                    <p style="margin-bottom: 1.5rem;">
                        Attirée par les domaines de la donnée et des systèmes d’information, je m’intéresse particulièrement à l’analyse des besoins,
                        à l’exploitation des données et à la conception de solutions décisionnelles. Mon objectif est de renforcer mes compétences afin
                        de contribuer à l’amélioration des systèmes d’information et d’accompagner la prise de décision grâce à une exploitation
                        pertinente des données.
                    </p>
                </div>

                <div class="card fade-in" style="animation-delay: 0.2s;">
                    <div style="text-align: center; padding: 2rem;">
                        <h4 style="font-size: 1.2rem; color: var(--text-dark); margin-bottom: 1rem;">À propos du BTS SIO</h4>
                        <p style="font-size: 0.95rem; color: var(--text-light); margin-bottom: 1rem;">
                            Le BTS SIO (Services Informatiques aux Organisations) est une formation de niveau bac+2 qui prépare aux
                            métiers de l’informatique au sein des entreprises et des organisations.
                        </p>

                        <ul style="list-style: none; padding: 0; margin: 0 0 1.5rem 0;">
                            <li><strong>SLAM</strong> (Solutions Logicielles et Applications Métiers) : <br> développement d’applications web et logicielles, bases de données, programmation.</li>
                            <li><strong>SISR</strong> (Solutions d’Infrastructure, Systèmes et Réseaux) : <br> administration des systèmes, réseaux et cybersécurité.</li>
                        </ul>

                        <div style="border-top: 1px solid var(--border); padding-top: 1rem; text-align: left;">
                            <p><strong>Compétences acquises :</strong></p>
                            <ul style="list-style: none; padding: 0; margin-top: 0.5rem;">
                                <li>Analyse des besoins</li>
                                <li>Développement d’applications</li>
                                <li>Gestion de projets</li>
                                <li>Cybersécurité</li>
                                <li>Support utilisateur</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Parcours Section -->
    <section class="section" id="parcours">
        <div class="container">
            <div class="section-title">
                <h2>Expériences</h2>
            </div>

            {% if experiences is not empty %}
                {% set formations = [] %}
                {% set professionnels = [] %}

                {% for exp in experiences %}
                    {% if exp.getType() == 'education' %}
                        {% set formations = formations|merge([exp]) %}
                    {% else %}
                        {% set professionnels = professionnels|merge([exp]) %}
                    {% endif %}
                {% endfor %}

                <!-- Formations -->
                {% if formations is not empty %}
                    <div style="margin-bottom: 4rem;">
                        <h3 style="margin-bottom: 2rem; font-size: 1.25rem; color: var(--primary);">📚 Formations</h3>
                        <div class="timeline">
                            {% for form in formations %}
                                <div class="timeline-item fade-in">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <div class="timeline-date">{{ form.getPeriod() }}</div>
                                        <h5 class="timeline-title">{{ form.getTitle() }}</h5>
                                        <p class="timeline-subtitle">
                                            {{ form.getCompany() }}
                                            {% if form.getLocation() %} • {{ form.getLocation() }}{% endif %}
                                        </p>
                                                                                {% if form.getDescription() %}
                                                                                    {% set items = form.getDescription()|split("\n") %}
                                                                                    <ul class="timeline-desc" style="padding-left: 1rem; margin: 0; text-align: justify;">
                                                                                        {% for it in items %}
                                                                                            {% if it|trim != '' %}
                                                                                                <li style="margin-bottom: 0.25rem; color: var(--text-light);">{{ it }}</li>
                                                                                            {% endif %}
                                                                                        {% endfor %}
                                                                                    </ul>
                                                                                {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- Expériences Professionnelles -->
                {% if professionnels is not empty %}
                    <div>
                        <h3 style="margin-bottom: 2rem; font-size: 1.25rem; color: var(--primary);">💼 Expériences Professionnelles</h3>
                        <div class="timeline">
                            {% for exp in professionnels %}
                                <div class="timeline-item fade-in">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <div class="timeline-date">{{ exp.getPeriod() }}</div>
                                        <h5 class="timeline-title">{{ exp.getTitle() }}</h5>
                                        <p class="timeline-subtitle">
                                            {{ exp.getCompany() }}
                                            {% if exp.getLocation() %} • {{ exp.getLocation() }}{% endif %}
                                        </p>
                                        {% if exp.getDescription() %}
                                            {% set items = exp.getDescription()|split("\n") %}
                                            <ul class="timeline-desc" style="padding-left: 1rem; margin: 0; text-align: justify;">
                                                {% for it in items %}
                                                    {% if it|trim != '' %}
                                                        <li style="margin-bottom: 0.25rem; color: var(--text-light);">{{ it }}</li>
                                                    {% endif %}
                                                {% endfor %}
                                            </ul>
                                        {% endif %}

                                        {% if exp.getSkills()|length > 0 %}
                                            <div style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                                {% for skill in exp.getSkills() %}
                                                    <span class="skill-badge">{{ skill.getNom() }}</span>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </section>

    <!-- Compétences Section -->
    <section class="section" id="competences">
        <div class="container">
            <div class="section-title">
                <h2>Compétences</h2>
            </div>

            {% if competences is not empty %}
                {% set grouped = {} %}
                {% for comp in competences %}
                    {% set cat = comp.getCategorie() %}
                    {% if grouped[cat]|default(null) is null %}
                        {% set grouped = grouped|merge({(cat): []}) %}
                    {% endif %}
                    {% set grouped = grouped|merge({(cat): grouped[cat]|merge([comp])}) %}
                {% endfor %}

                {% for categorie, comps in grouped %}
                    <div class="fade-in" style="margin-bottom: 3rem;">
                        <h3 style="margin-bottom: 2rem; font-size: 1.2rem;">
                            {% if categorie == 'Backend' %}
                                🔧
                            {% elseif categorie == 'Frontend' %}
                                🎨
                            {% elseif categorie == 'Database' or categorie == 'Bases de données' %}
                                🗄️
                            {% else %}
                                ⚙️
                            {% endif %}
                            {{ categorie|default('Autres') }}
                        </h3>

                        <div class="skills-grid">
                            {% for comp in comps %}
                                <div class="card" style="text-align: center; padding: 1.5rem;">
                                    <h5 style="font-size: 1rem; color: var(--text-dark); font-weight: 600; margin-bottom: 0.5rem;">{{ comp.getNom() }}</h5>
                                    <p class="text-muted" style="font-size: 0.9rem; margin: 0;">
                                        {{ comp.getDescription()|slice(0, 60) }}{% if comp.getDescription()|length > 60 %}...{% endif %}
                                    </p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </section>

    <!-- Certifications Section -->
    <section class="section" id="certifications">
        <div class="container">
            <div class="section-title">
                <h2>Certifications</h2>
            </div>

            {% if certifications is not empty %}
                <div class="projects-grid">
                    {% for cert in certifications %}
                        <div class="project-card fade-in">
                            <div class="project-image" style="background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); font-size: 3rem; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                                {# If a badge image filename is set, try to display it (admin may store badges under uploads/...)
                                   Otherwise, if a PDF certificate file exists, show a small embedded preview of the PDF.
                                   Fallback to the trophy emoji when no visual file is available. #}
                                {% if cert.getBadge() is not null and cert.getBadge() != '' %}
                                    <img src="{{ asset('uploads/certifications/' ~ cert.getBadge()) }}" alt="{{ cert.getTitre() }}" style="max-width:100%; max-height:120px; object-fit:contain;">
                                {% elseif cert.getCertificatFile() is not null and cert.getCertificatFile() != '' %}
                                    {# Afficher une vignette cliquable pour le PDF ; si une miniature (png) existe sous public/certifications/thumbnails/, elle sera affichée, sinon on verra un placeholder PDF #}
                                    <a href="{{ asset('certifications/' ~ cert.getCertificatFile()) }}" target="_blank" style="display:block; width:100%; height:120px;">
                                        <div style="position:relative; width:100%; height:120px; overflow:hidden; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);">
                                            <img src="{{ asset('certifications/thumbnails/' ~ cert.getCertificatFile()|replace({'.pdf': '.png', '.PDF': '.png'})) }}" alt="{{ cert.getTitre() }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" onload="this.nextElementSibling.style.display='none';" onerror="this.style.display='none';">
                                            <div style="position:relative; z-index:1; display:flex; align-items:center; justify-content:center; width:100%; height:100%; color:#fff;">
                                                <i class="fas fa-file-pdf" style="font-size:2rem; margin-right:0.5rem;"></i>
                                                <span>PDF</span>
                                            </div>
                                        </div>
                                    </a>
                                {% else %}
                                    🏆
                                {% endif %}
                            </div>
                            <div class="project-content">
                                <h4 class="project-title">{{ cert.getTitre() }}</h4>
                                <p class="timeline-subtitle" style="margin-bottom: 0.5rem;">{{ cert.getOrganisation() }}</p>
                                {% if cert.getDateObtention() %}
                                    <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 1rem;">
                                        📅 {{ cert.getDateObtention()|date('d/m/Y') }}
                                    </p>
                                {% endif %}
                                <p class="project-desc">
                                    {{ cert.getDescription() ?? 'Certification obtenue' }}
                                </p>
                                <div class="project-links">
                                    {% if cert.getCertificatFile() %}
                                        <a href="{{ asset('certifications/' ~ cert.getCertificatFile()) }}" target="_blank" title="Ouvrir / Télécharger le certificat">
                                            <i class="fas fa-file-pdf"></i> Ouvrir
                                        </a>
                                        <a href="{{ asset('certifications/' ~ cert.getCertificatFile()) }}" download style="margin-left:0.5rem;">
                                            <i class="fas fa-download"></i>
                                        </a>
                                    {% endif %}

                                    {% if cert.getUrl() %}
                                        <a href="{{ cert.getUrl() }}" target="_blank" class="btn-link" title="Vérifier la certification" style="margin-left:0.75rem;">
                                            <i class="fas fa-external-link-alt"></i> Vérifier
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-muted">Aucune certification enregistrée pour le moment.</p>
            {% endif %}
        </div>
    </section>

    <!-- Projets Section -->
    <section class="section" id="projets">
        <div class="container">
            <div class="section-title">
                <h2>Projets Réalisés</h2>
            </div>

            {% if projets is not empty %}
                {% set grouped = {} %}
                {% for proj in projets %}
                    {% set cat = proj.getCategorie()|default('Autres') %}
                    {# Use default([]) when accessing grouped[cat] to avoid "key does not exist" errors #}
                    {% set existing = grouped[cat]|default([]) %}
                    {% set grouped = grouped|merge({ (cat): existing|merge([proj]) }) %}
                {% endfor %}

                {% for categorie, projs in grouped %}
                    <div class="fade-in" style="margin-bottom: 3rem;">
                        <h3 style="margin-bottom: 2rem;">📌 {{ categorie }}</h3>
                        <div class="projects-grid">
                            {% for proj in projs %}
                                <div class="project-card">
                                    <div class="project-image" style="background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);">
                                        💼
                                    </div>
                                    <div class="project-content">
                                        <h4 class="project-title">{{ proj.getTitre() }}</h4>

                                        {% if proj.getMatiere() %}
                                            <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 0.5rem;">
                                                📚 {{ proj.getMatiere() }}
                                            </p>
                                        {% endif %}

                                        <p class="project-desc">
                                            {{ proj.getDescription() }}
                                        </p>

                                        <div class="project-links">
                                            {% if proj.getLinkGithub() %}
                                                <a href="{{ proj.getLinkGithub() }}" target="_blank" title="Code source">
                                                    <i class="fab fa-github"></i>
                                                </a>
                                            {% endif %}
                                            {% if proj.getLinkDownload() %}
                                                <a href="{{ proj.getLinkDownload() }}" target="_blank" title="Télécharger">
                                                    <i class="fas fa-download"></i>
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-muted">Aucun projet enregistré.</p>
            {% endif %}
        </div>
    </section>

    <!-- Documents Section -->
    <section class="section" id="documents">
        <div class="container">
            <div class="section-title">
                <h2>Documents</h2>
            </div>

            <div class="documents-grid">
                <!-- Veille Technologique -->
                <div class="card fade-in">
                    <div style="text-align: center; padding: 2rem;">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">📰</div>
                        <h4 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem;">Veille Technologique</h4>
                        <p class="text-muted" style="margin-bottom: 1.5rem;">
                            Découvrez ma sélection des dernières tendances et innovations technologiques
                        </p>
                        <a href="#veille-list" class="btn btn-primary btn-sm">Consulter ma veille</a>
                    </div>
                </div>

                <!-- CV et Tableau de Synthèse -->
                <div class="card fade-in" style="animation-delay: 0.1s;">
                    <div style="text-align: center; padding: 2rem;">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">📄</div>
                        <h4 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem;">Ressources</h4>
                        <p class="text-muted" style="margin-bottom: 1.5rem;">
                        </p>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem;">
                            <a href="{{ asset('documents/CV_Jingyuan_LUO_Alternance.pdf') }}" target="_blank" class="card" style="text-align: left; padding: 1rem; display:flex; gap:0.75rem; align-items:center;">
                                <div style="font-size: 1.75rem; color: var(--primary);">📄</div>
                                <div>
                                    <div style="font-weight:600;">CV</div>
                                    <div style="font-size:0.85rem; color:var(--text-light);">Télécharger mon CV</div>
                                </div>
                            </a>

                            <a href="{{ asset('documents/Tableau-de-synthese-Epreuve-E5-Jingyuan-LUO.pdf') }}" target="_blank" class="card" style="text-align: left; padding: 1rem; display:flex; gap:0.75rem; align-items:center;">
                                <div style="font-size: 1.75rem; color: var(--primary);">📊</div>
                                <div>
                                    <div style="font-weight:600;">Tableau de synthèse - E5</div>
                                    <div style="font-size:0.85rem; color:var(--text-light);">Télécharger le tableau de synthèse</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Veille List -->
            <div id="veille-list">
                <h3 style="margin-bottom: 2rem; font-size: 1.2rem;">Dernières Veilles</h3>
                <div class="veille-grid">
                    <!-- Document Veille Technologique statique -->
                    <div class="veille-card fade-in">
                        <div class="veille-icon">📚</div>
                        <h5 class="veille-title">Veille Technologique</h5>
                        <p class="veille-desc">
                            Analyse complète des tendances actuelles en cybersécurité et technologies de l'information. Ce document présente les outils et méthodologies de veille technologique, ainsi que ma veille réalisée sur les innovations du secteur.
                        </p>
                        <div class="veille-meta">
                            <div style="display: flex; gap: 0.5rem;">
                                <a href="{{ asset('documents/Veille-Technologique_Jingyuan_LUO.pdf') }}" target="_blank" class="btn btn-sm btn-primary" title="PDF">
                                    <i class="fas fa-file-pdf"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    {% for veille in veilles %}
                        <div class="veille-card fade-in">
                            <div class="veille-icon">📚</div>
                            <h5 class="veille-title">{{ veille.getTitre() }}</h5>

                            {% if veille.getCategorie() %}
                                <div style="margin-bottom: 0.75rem;">
                                    <span class="skill-badge" style="font-size: 0.7rem;">{{ veille.getCategorie() }}</span>
                                </div>
                            {% endif %}

                            <p class="veille-desc">
                                {{ veille.getDescription() }}
                            </p>

                            <div class="veille-meta">
                                <span style="font-size: 0.8rem;">{{ veille.getDate()|date('d/m/Y') }}</span>
                                <div style="display: flex; gap: 0.5rem;">
                                    {% if veille.getPdfFile() %}
                                        <a href="{{ asset('uploads/veille/' ~ veille.getPdfFile()) }}" target="_blank" class="btn btn-sm btn-primary" title="PDF">
                                            <i class="fas fa-file-pdf"></i>
                                        </a>
                                    {% endif %}
                                    {% if veille.getUrl() %}
                                        <a href="{{ veille.getUrl() }}" target="_blank" class="btn btn-sm btn-secondary" style="color: var(--primary); border-color: var(--primary);" title="Lien">
                                            <i class="fas fa-link"></i>
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="section" id="contact">
        <div class="container">
            <div class="section-title">
                <h2>Contact</h2>
            </div>

            <div id="contact-notification" class="contact-notification" style="display: none;">
                <span id="notification-message"></span>
                <button class="notification-close" onclick="document.getElementById('contact-notification').style.display = 'none';">&times;</button>
            </div>

            <div class="contact-grid">
                <div class="fade-in">
                    <h3 style="margin-bottom: 1.5rem; font-size: 1.2rem;">Me contacter</h3>

                    <div class="contact-section" style="margin-bottom: 0;">
                        <form id="contact-form" class="contact-form" method="POST" action="{{ path('app_contact_send') }}" enctype="multipart/form-data">
                            <input type="hidden" name="contact[nom]" id="contact_nom" class="form-input">
                            <input type="hidden" name="contact[prenom]" id="contact_prenom" class="form-input">
                            <input type="hidden" name="contact[email]" id="contact_email" class="form-input">
                            <input type="hidden" name="contact[sujet]" id="contact_sujet" class="form-input">
                            <input type="hidden" name="contact[message]" id="contact_message" class="form-textarea">

                            <div class="form-group">
                                <label class="form-label" for="nom">Nom</label>
                                <input type="text" name="nom" id="nom" class="form-input" required autocomplete="family-name">
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="prenom">Prénom</label>
                                <input type="text" name="prenom" id="prenom" class="form-input" required autocomplete="given-name">
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="email">Email</label>
                                <input type="email" name="email" id="email" class="form-input" required autocomplete="email">
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="sujet">Sujet</label>
                                <input type="text" name="sujet" id="sujet" class="form-input" required>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="message">Message</label>
                                <textarea name="message" id="message" class="form-textarea" required></textarea>
                            </div>

                            <div style="margin-top: 2rem;">
                                <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">Envoyer</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="fade-in" style="animation-delay: 0.2s;">
                    <h3 style="margin-bottom: 1.5rem; font-size: 1.2rem;">Me suivre</h3>
                    <p class="text-muted" style="margin-bottom: 2rem;">
                        Retrouvez-moi sur les réseaux sociaux et plateformes professionnelles
                    </p>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <a href="https://github.com/Juy246" target="_blank" class="card" style="text-align: center; padding: 1.5rem; transition: all 0.3s ease; border: 1px solid var(--border);">
                            <i class="fab fa-github" style="font-size: 2rem; margin-bottom: 0.5rem; color: var(--primary);"></i>
                            <h5 style="font-size: 0.95rem; margin: 0;">GitHub</h5>
                        </a>

                        <a href="https://www.linkedin.com/in/jingyuan-annie-luo/" target="_blank" class="card" style="text-align: center; padding: 1.5rem; transition: all 0.3s ease; border: 1px solid var(--border);">
                            <i class="fab fa-linkedin" style="font-size: 2rem; margin-bottom: 0.5rem; color: var(--primary);"></i>
                            <h5 style="font-size: 0.95rem; margin: 0;">LinkedIn</h5>
                        </a>

                        <a href="mailto:annieluo@outlook.fr" class="card" style="text-align: center; padding: 1.5rem; transition: all 0.3s ease; border: 1px solid var(--border);">
                            <i class="fas fa-envelope" style="font-size: 2rem; margin-bottom: 0.5rem; color: var(--primary);"></i>
                            <h5 style="font-size: 0.95rem; margin: 0;">Email</h5>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Function to show notification
        function showNotification(message, isSuccess) {
            const notification = document.getElementById('contact-notification');
            const messageEl = document.getElementById('notification-message');

            notification.classList.remove('success', 'error');
            notification.classList.add(isSuccess ? 'success' : 'error');
            messageEl.textContent = message;
            notification.style.display = 'flex';

            // Auto-hide after 6 seconds
            setTimeout(() => {
                notification.style.display = 'none';
            }, 6000);
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Handle contact form submission
            const contactForm = document.getElementById('contact-form');
            if (contactForm) {
                contactForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const formData = new FormData(this);

                    fetch(this.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showNotification(data.message, true);
                            contactForm.reset();
                        } else {
                            showNotification(data.message || 'Le message n\'est pas envoyé, ressayez', false);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Le message n\'est pas envoyé, ressayez', false);
                    });
                });
            }

            // Smooth scroll for navigation links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    const href = this.getAttribute('href');
                    if (href !== '#' && document.querySelector(href)) {
                        e.preventDefault();
                        document.querySelector(href).scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // Tab management for navbar links (robust): try multiple selectors to find a bootstrap tab toggle
            const navbarLinks = document.querySelectorAll('nav .navbar-nav a[href*="#"]');
            navbarLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    const href = this.getAttribute('href');
                    const match = href && href.match(/#([^&?]+)/);
                    if (!match || !match[1]) return;
                    const targetId = match[1];

                    // Look for different possible tab toggles that reference the target id
                    const selectors = [
                        `[data-bs-toggle="tab"][href="#${targetId}"]`,
                        `[data-bs-toggle="tab"][data-bs-target="#${targetId}"]`,
                        `[role="tab"][data-bs-target="#${targetId}"]`,
                        `[role="tab"][href="#${targetId}"]`,
                        `[data-toggle="tab"][href="#${targetId}"]`,
                        `[data-toggle="tab"][data-target="#${targetId}"]`
                    ];

                    let tabElement = null;
                    for (const sel of selectors) {
                        tabElement = document.querySelector(sel);
                        if (tabElement) break;
                    }

                    if (tabElement && typeof bootstrap !== 'undefined' && bootstrap.Tab) {
                        // Prevent default anchor jump, activate the tab and scroll
                        e.preventDefault();
                        try {
                            const tab = new bootstrap.Tab(tabElement);
                            tab.show();
                        } catch (err) {
                            // ignore
                        }

                        // If there's a nav section for tabs, scroll to it; otherwise, scroll to the anchor target
                        const tabsNav = document.querySelector('.portfolio-tabs-nav') || document.getElementById(targetId);
                        if (tabsNav) {
                            tabsNav.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    } else {
                        // No tab toggle found: let the normal anchor behaviour (smooth scroll) handle it
                    }
                });
            });

            // Reveal animation on scroll for .fade-in and .reveal
            const revealElements = document.querySelectorAll('.fade-in, .reveal');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.animationPlayState = 'running';
                    }
                });
            }, { threshold: 0.1 });

            revealElements.forEach(el => {
                el.style.animationPlayState = 'paused';
                observer.observe(el);
            });

            // Active navigation highlight
            const sections = document.querySelectorAll('section[id]');
            const navLinks = document.querySelectorAll('nav a[href^="#"]');

            window.addEventListener('scroll', () => {
                let current = '';
                sections.forEach(section => {
                    const sectionTop = section.offsetTop;
                    if (pageYOffset >= sectionTop - 200) {
                        current = section.getAttribute('id');
                    }
                });

                navLinks.forEach(link => {
                    link.style.color = '';
                    link.style.borderBottomColor = 'transparent';
                    if (link.getAttribute('href').slice(1) === current) {
                        link.style.color = 'var(--primary)';
                        link.style.borderBottomColor = 'var(--primary)';
                    }
                });
            });
        });
    </script>
