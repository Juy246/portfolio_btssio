{% extends 'base.html.twig' %}

{% block title %}Projets - Portfolio{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-5 text-center">Mes Projets</h1>

        {% if grouped_projets is not empty %}
            {% for categorie, projets in grouped_projets %}
                <section class="mb-5">
                    <h2 class="border-bottom pb-2 mb-4"> {{ categorie }}</h2>

                    <div class="projects-grid">
                        {% for proj in projets %}
                            <div class="project-card">
                                {% if proj.getImageProjet() %}
                                    <div class="project-image">
                                        <img src="{{ asset('images/projets/' ~ proj.getImageProjet()) }}" alt="{{ proj.getTitre() }}" />
                                    </div>
                                {% endif %}
                                <div class="project-content">
                                    <h5 class="project-title">{{ proj.getTitre() }}</h5>
                                    <p class="project-desc">
                                        {{ proj.getDescription() }}
                                    </p>
                                    <div class="project-links">
                                        {% if proj.getLinkGithub() %}
                                            <a href="{{ proj.getLinkGithub() }}" target="_blank" title="Voir le code">
                                                <i class="fab fa-github"></i> Code
                                            </a>
                                        {% endif %}
                                        {% if proj.getLinkDownload() %}
                                            <a href="{{ proj.getLinkDownload() }}" target="_blank" title="Télécharger">
                                                <i class="fas fa-download"></i> Docs
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        {% else %}
            <p class="text-muted text-center">Aucun projet enregistré.</p>
        {% endif %}

        <div class="text-center mt-5">
            <a href="{{ path('app_home') }}" class="btn btn-primary">
                ← Retour à l'accueil
            </a>
        </div>
    </div>
{% endblock %}

