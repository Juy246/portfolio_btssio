{% extends 'base.html.twig' %}

{% block title %}Projets - Portfolio{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-5 text-center">Mes Projets</h1>

        {% if grouped_projets is not empty %}
            {% for categorie, projets in grouped_projets %}
                <section class="mb-5">
                    <h2 class="border-bottom pb-2 mb-4"> {{ categorie }}</h2>

                    <div class="row">
                        {% for proj in projets %}
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body">
                                        <h5 class="card-title fw-bold">{{ proj.getTitre() }}</h5>
                                        {% if proj.getMatiere() %}
                                            <p style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 0.5rem;">
                                                 {{ proj.getMatiere() }}
                                            </p>
                                        {% endif %}
                                        <p class="card-text text-muted" style="margin-bottom: 1.5rem;">
                                            {{ proj.getDescription() }}
                                        </p>
                                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                            {% if proj.getLinkGithub() %}
                                                <a href="{{ proj.getLinkGithub() }}" target="_blank" class="btn btn-sm btn-primary">
                                                    <i class="fab fa-github"></i> Code
                                                </a>
                                            {% endif %}
                                            {% if proj.getLinkDownload() %}
                                                <a href="{{ proj.getLinkDownload() }}" target="_blank" class="btn btn-sm btn-primary">
                                                    <i class="fas fa-download"></i> Docs
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        {% else %}
            <p class="text-muted text-center">Aucun projet enregistré.</p>
        {% endif %}

        <div class="text-center mt-5">
            <a href="{{ path('app_home') }}" class="btn btn-primary">
                ← Retour à l'accueil
            </a>
        </div>
    </div>
{% endblock %}

